# ========================================================
# Textile Shop Billing & Management Software - Environment Configuration
# ========================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Security & Session Configuration (Change in Production!)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRES_IN=7d

# Allowed Cross-Origin Origins (Comma-separated for multiple)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Database Configuration
DB_FILENAME=textile_billing.db

# Backup Configuration
BACKUP_RETENTION_DAYS=14
